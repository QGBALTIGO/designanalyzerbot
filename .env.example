# Telegram - adicionar somente quando for ligar o bot real
BOT_TOKEN=
ADMIN_IDS=

# Persistência
DATABASE_PATH=data/designanalyzer.db
WORK_DIR=data/jobs
PREMIUM_DIR=data/premium

# Processamento
DESIGNSYS_BIN=designsys
ANALYSIS_TIMEOUT_SECONDS=900
MAX_CONCURRENT_ANALYSES=1
MAX_RESULT_MB=45
CAPTURE_TIMEOUT_SECONDS=300
MAX_CONCURRENT_CAPTURES=1
MAX_CAPTURE_ASSETS=300
MAX_CAPTURE_MB=45
AUDIT_TIMEOUT_SECONDS=420
MAX_CONCURRENT_PREMIUM=1
LIGHTHOUSE_BIN=lighthouse
TECH_FINGERPRINTS_PATH=/opt/webanalyze/technologies.json
ANALYZER_MOCK=0

# Limites iniciais (podem ser alterados sem mudar código)
FREE_MONTHLY_LIMIT=1
PRO_MONTHLY_LIMIT=10
AGENCY_MONTHLY_LIMIT=100
FREE_PAGES=2
PRO_PAGES=8
AGENCY_PAGES=20
PRO_CLONE_PAGES=3
AGENCY_CLONE_PAGES=12
PRO_PREMIUM_CREDITS=50
AGENCY_PREMIUM_CREDITS=500

# IA opcional para /modernizar e /inspirar. Sem chave, usa fallback local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

LOG_LEVEL=INFO
